# Supabase Connection Settings
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Verification Secret (found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# FastAPI Application Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8085
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8085", "http://127.0.0.1:8085"]

# Optional Python desktop dashboard face-record source.
# Use the home UUID and a current Supabase user access token that owns that home.
API_BASE_URL=http://127.0.0.1:8085
SECURITY_HOME_ID=your-home-uuid
FACEOCC_MODEL_PATH=models/faceocc.onnx
FACEOCC_MAX_RESULT_AGE_SECONDS=2.0
SUPABASE_ACCESS_TOKEN=your-current-user-access-token
ALLOW_LOCAL_FACE_DATABASE=false
FACE_PROCESS_EVERY_N_FRAMES=3
STREAM_STALE_AFTER_SECONDS=3
STREAM_REPEATED_SEQUENCE_LENGTH=4
STREAM_REPLAY_REPEATS=3
STREAM_SCENE_CHANGE_DISTANCE=48
STREAM_EVENT_COOLDOWN=10
STREAM_MAX_FRAME_BYTES=5242880
SECURITY_EVIDENCE_DIR=data/security_evidence
SECURITY_EVIDENCE_RETENTION_DAYS=30
FACE_QUALITY_MINIMUM_WIDTH=32
FACE_QUALITY_MINIMUM_SHARPNESS=4.0
CAMERA_OBSTRUCTION_DARKNESS=8.0
CAMERA_OBSTRUCTION_SHARPNESS=1.0
API_RATE_LIMIT_PER_MINUTE=1200

# =============================================================================
# Environment & Test Mode
# =============================================================================

# Identifies the deployment environment.
# Accepted values: development (default), staging, production.
# Setting ENVIRONMENT=production enables additional safety guards, including
# blocking the TEST_ISOLATED_MODE in-memory fallback (see below).
ENVIRONMENT=development

# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# WARNING — TEST_ISOLATED_MODE
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# This variable is EXCLUSIVELY for isolated automated tests that must run
# without a live Supabase connection.  When set to 1:
#   - All database reads/writes are redirected to in-process memory dictionaries.
#   - No data is persisted to Supabase.
#   - All data is lost when the process exits.
#   - Setting ENVIRONMENT=production with TEST_ISOLATED_MODE=1 will raise a
#     RuntimeError at startup to prevent accidental activation.
#
# DO NOT SET THIS IN PRODUCTION, STAGING, OR ANY SHARED ENVIRONMENT.
# It must only be present in the environment during automated test runs:
#
#   TEST_ISOLATED_MODE=1 python -m pytest tests/
#
# Do NOT add this line to a persistent .env file on a server.
# TEST_ISOLATED_MODE=1
